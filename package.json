    "smoke": "npm run test && npm run build",
    "icons": "node scripts/generate-favicon.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.27",
    "@angular/cli": "^19.2.27",
    "@angular/compiler-cli": "^19.2.0",
    "@resvg/resvg-js": "^2.6.2",
    "to-ico": "^1.1.5",
    "typescript": "~5.7.2",
    "vitest": "^3.2.4"
  }
}
