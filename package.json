{
  "name": "digital_space",
  "version": "3.18.82",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 5173 --host localhost",
    "start:lan": "ng serve --port 5173 --host 0.0.0.0",
    "start:api": "npm --prefix recovery-api start",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
